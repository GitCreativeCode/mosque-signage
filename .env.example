# ==============================================================================
# MosqueSignage - Appliance Environment Configuration Template
# Copy this file to .env.local for local overrides or configure in Docker Compose
# ==============================================================================

# Server Network Port (Default: 3000)
PORT=3000

# Reverse Proxy & SSL Header Trust (Default: false)
# Set to 'true' when deployed behind Cloudflare Tunnel, Caddy, or Nginx.
TRUST_PROXY_HEADERS=false

# Public Access Hardening (Default: false)
# Set to 'true' on public domain deployments to enforce complex password policies
# and reject factory default credentials.
PUBLIC_ACCESS_MODE=false

# Maximum Concurrent Display Server-Sent Events (SSE) Streams (Default: 25)
MAX_SSE_CONNECTIONS=25

# Admin Session Secret (Auto-generated 32-byte hex if omitted)
# ADMIN_SESSION_SECRET=your_32_byte_cryptographic_secret_here

# Cookie Secure Flag Override ('true' or 'false', auto-detected by default)
# COOKIE_SECURE=true

# Optional Appliance Update Command (For automated Git / container update workflows)
# MOSQUE_UPDATE_COMMAND=git pull origin main && npm install && npm run build
