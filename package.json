    "db:seed": "tsx src/lib/db/seed.ts",
    "reset-auth": "tsx scripts/reset-auth.ts",
    "reset-pin": "tsx scripts/reset-pin.ts"
  },
  "dependencies": {
    "adhan": "^4.4.6",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.16.0",
    "next": "^16.4.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
