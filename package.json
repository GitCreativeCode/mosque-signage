  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "build:docker": "BUILD_STANDALONE=true next build",
    "prestart": "node scripts/ensure-build.mjs",
    "start": "node scripts/start-server.mjs",
    "autostart": "node scripts/manage-autostart.mjs",
    "migrate-data": "node scripts/migrate-data.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
